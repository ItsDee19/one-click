# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values. Never commit ".env".
# ---------------------------------------------------------------------------

# --- Telegram (required for signals to actually be delivered) --------------
# Bot token from @BotFather, e.g. 1234567890:AAH...   (kept out of all logs/UI)
TELEGRAM_BOT_TOKEN=
# Your numeric chat id from @userinfobot, e.g. 987654321
TELEGRAM_CHAT_ID=

# --- LLM debate engine (all optional) --------------------------------------
# Leave everything blank to auto-detect. Priority: claude_code -> anthropic -> openai
# Force one with: claude_code | anthropic | openai
LLM_PROVIDER=
# Only needed for the "anthropic" provider (the claude CLI needs no key)
ANTHROPIC_API_KEY=
# Only needed for the "openai" provider
OPENAI_API_KEY=
# Model used by the claude CLI / Anthropic API: sonnet (better judgement,
# slower and heavier on your plan) or haiku (fast and cheap)
CLAUDE_CLI_MODEL=sonnet
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
# Seconds to wait for one LLM debate call before falling back to the rule engine
LLM_TIMEOUT=240
# How many stocks to debate at once (each is one CLI/API call)
LLM_CONCURRENCY=3

# --- Behaviour --------------------------------------------------------------
BRAND=Dalal Desk
# A BUY fires a Telegram signal only at or above this confidence (1-10)
CONFIDENCE_THRESHOLD=7
# Seconds each agent visibly spends "working" (pure UI pacing)
AGENT_DELAY=0.6
# How many movers per cap bucket go through to the debate
SHORTLIST_PER_BUCKET=4
# Research every NSE main-board and SME trading-list entry by default.
# Set 0 only to explicitly opt into the smaller curated universe.json.
FULL_EXCHANGE=1
# all = price/strategy analysis plus company metrics, analyst evidence and news
# daily = all-stock price/strategy analysis only (no company research)
INTELLIGENCE_RESEARCH_SCOPE=all
INTELLIGENCE_WORKERS=4
# Quote downloads are bounded to protect provider availability.
MARKET_BATCH_SIZE=100
MARKET_DOWNLOAD_THREADS=4
MARKET_DOWNLOAD_RETRIES=1
MARKET_DATA_TIMEOUT=15
# Company profiles cache for six hours; headlines refresh every 30 minutes.
INTELLIGENCE_COMPANY_TTL_SECONDS=21600
INTELLIGENCE_NEWS_TTL_SECONDS=1800
# Web server port
PORT=5000

# --- Unattended schedule ----------------------------------------------------
# Runs automatically at these IST times on weekdays. 09:00 is the pre-open
# briefing (positional picks are real, intraday is a watchlist); 09:45 is the
# confirmation run once the opening range has printed.
SCHEDULE_ENABLED=1
SCHEDULE_TIMES=09:00,09:45
SCHEDULE_MODE=live
# After the fixed slots, keep running every N minutes while the market is
# actually open, so the board follows the tape instead of going stale at 09:45.
# 0 disables the sweeps and leaves only the fixed times above.
SCHEDULE_INTERVAL_MINUTES=30
SCHEDULE_FOLLOW_SESSION=1
# Don't re-send a positional BUY that is still open within this many days
SIGNAL_COOLDOWN_DAYS=5

# --- Paper trading -----------------------------------------------------------
# SIMULATED ONLY. There is no broker integration in this project and no code
# path that can place a real order. This sizes and tracks a virtual account so
# the strategy can be judged on results before any money is involved.
PAPER_TRADING=1
PAPER_CAPITAL=100000

# --- Risk limits (every one of these is a refusal condition) ------------------
# Max % of capital risked on a single trade — drives position size
RISK_PER_TRADE_PCT=1.0
# Max % of capital in any one position
MAX_POSITION_PCT=20.0
# Max positions held at once
MAX_CONCURRENT_POSITIONS=5
# Circuit breaker: stop opening anything once the day is down this much
MAX_DAILY_LOSS_PCT=3.0
# Max new positions opened in a day
MAX_DAILY_TRADES=6
# Max % of capital in any one sector
MAX_SECTOR_PCT=40.0
# Fraction of capital never deployed
CASH_RESERVE_PCT=20.0
# Assumed adverse fill, in %
SLIPPAGE_PCT=0.05

# --- Web research ------------------------------------------------------------
# Pull public RSS headlines. Fetched text is sanitised and treated as untrusted
# data — never as instructions.
WEB_RESEARCH=1

# --- Deployment (only needed when frontend and backend are hosted apart) -----
# Bind address. 127.0.0.1 locally; a container needs 0.0.0.0 to be reachable.
HOST=127.0.0.1
# Where signals.db lives. Point this at a mounted volume in a container, or
# every deploy wipes the track record. Defaults to the project directory.
DB_DIR=
# Exact origins allowed to call this API, comma separated. Leave empty when
# Flask serves the dashboard itself. Never use "*" — this API exposes your
# positions, paper account and track record.
ALLOWED_ORIGINS=
